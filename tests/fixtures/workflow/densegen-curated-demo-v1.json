  "source_config": {
    "densegen": {
      "schema_version": "2.9",
      "run": {
        "id": "demo_tfbs_baseline",
        "root": "."
      },
      "inputs": [
        {
          "name": "basic_sites",
          "type": "binding_sites",
          "path": "inputs/sites.csv"
