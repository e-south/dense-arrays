          "library_size": 10,
          "cover_all_regulators": true,
          "unique_binding_sites": true,
          "unique_binding_cores": true,
          "iterative_max_libraries": 200
        },
        "plan": [
          {
            "name": "baseline",
            "sequences": 50,
            "sampling": {
              "include_inputs": [
                "basic_sites"
              ]
            },
            "regulator_constraints": {
              "min_total_sites": 0,
              "groups": []
            }
          },
          {
            "name": "baseline_sigma70",
            "sequences": 50,
            "sampling": {
              "include_inputs": [
                "basic_sites"
              ]
            },
            "fixed_elements": {
